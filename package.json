{
  "name": "create-99l-ground-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "99L rocket ground station for Windows and Linux",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.js\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite --config vite.config.js",
    "build:renderer": "vite build --config vite.config.js",
    "start": "electron .",
    "build": "npm run build:renderer && electron-builder --publish never",
    "build:win": "npm run build:renderer && electron-builder --win portable --x64 --publish never",
    "build:linux": "npm run build:renderer && electron-builder --linux AppImage --x64 --publish never",
    "cli": "node scripts/ground-cli.mjs",
    "test": "node tests/protocol-smoke.mjs"
  },
  "dependencies": {
    "serialport": "^13.0.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "jp.create.rocket.groundstation99l",
    "productName": "CREATE 99L Ground Station",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "CREATE-99L-Ground-Station-${version}-Windows-x64.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "artifactName": "CREATE-99L-Ground-Station-${version}-Linux-x64.${ext}"
    },
    "appImage": {
      "artifactName": "CREATE-99L-Ground-Station-${version}-Linux-x64.${ext}"
    }
  }
}
